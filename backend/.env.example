# =============================================================================
# Project SC Backend – environment example
# Copy to .env (for test) and .env.production (for prod). Do not commit secrets.
# =============================================================================

# Environment selection
# CT_ENV=test  -> Crunchtime test URL + *_TEST tokens + sitename_TEST etc. + test DB
# CT_ENV=prod  -> Crunchtime prod URL + *_PROD tokens + sitename_PROD etc. + prod DB
CT_ENV=test

# Load .env.production when starting for production (start_prod.bat sets this)
# APP_ENV=production

# -----------------------------------------------------------------------------
# Crunchtime – TEST (used when CT_ENV=test in .env)
# -----------------------------------------------------------------------------
sitename_TEST=<site-test>
userid_TEST=<user-test>
password_TEST=<password-test>

CRUNCHTIME_LOCATION_TOKEN_TEST=<token>
CRUNCHTIME_HIERARCHY_TOKEN_TEST=<token>
CRUNCHTIME_VENDOR_TOKEN_TEST=<token>
CRUNCHTIME_VENDOR_LOCATION_TOKEN_TEST=<token>
CRUNCHTIME_COMPANY_PRODUCT_ENHANCED_TOKEN_TEST=<token>
CRUNCHTIME_VENDOR_PRODUCT_PRICING_TOKEN_TEST=<token>
CRUNCHTIME_PURCHASE_ORDERS_TOKEN_TEST=<token>
# Confirm Receipt Standard API (getAllConfirmReceiptsStandard); not the same as purchase orders token.
CRUNCHTIME_CONFIRM_RECEIPT_STANDARD_TOKEN_TEST=<token>
CRUNCHTIME_LOCATION_PRODUCT_PRICING_TOKEN_TEST=<token>
CRUNCHTIME_CATEGORY_TOKEN_TEST=<token>

# -----------------------------------------------------------------------------
# Crunchtime – PROD (used when CT_ENV=prod in .env.production)
# -----------------------------------------------------------------------------
sitename_PROD=<site-prod>
userid_PROD=<user-prod>
password_PROD=<password-prod>

CRUNCHTIME_LOCATION_TOKEN_PROD=<token>
CRUNCHTIME_HIERARCHY_TOKEN_PROD=<token>
CRUNCHTIME_VENDOR_TOKEN_PROD=<token>
CRUNCHTIME_VENDOR_LOCATION_TOKEN_PROD=<token>
CRUNCHTIME_COMPANY_PRODUCT_ENHANCED_TOKEN_PROD=<token>
CRUNCHTIME_VENDOR_PRODUCT_PRICING_TOKEN_PROD=<token>
CRUNCHTIME_PURCHASE_ORDERS_TOKEN_PROD=<token>
CRUNCHTIME_CONFIRM_RECEIPT_STANDARD_TOKEN_PROD=<token>
CRUNCHTIME_LOCATION_PRODUCT_PRICING_TOKEN_PROD=<token>
CRUNCHTIME_CATEGORY_TOKEN_PROD=<token>

# -----------------------------------------------------------------------------
# PostgreSQL (Auto Allocation + product catalogue)
# Test:  GYG-CT-Helper_TEST   (use in .env)
# Prod:  GYG-CT-Helper_PROD   (use in .env.production)
# -----------------------------------------------------------------------------
pgName=<db-user>
pgPassword=<db-password>
pgHost=localhost
pgPort=5432
pgDatabase=GYG-CT-Helper_TEST

# -----------------------------------------------------------------------------
# Public Holidays API (optional)
# -----------------------------------------------------------------------------
API_NINJAS_KEY=<key>

# =============================================================================
# How to start TEST vs PROD
# =============================================================================
# TEST (default): Use .env with CT_ENV=test, pgDatabase=GYG-CT-Helper_TEST.
#   Backend:  From project root run start_test.bat
#             (or: cd backend && python -m uvicorn app.main:app --reload --host 0.0.0.0 --port 8000)
#   Frontend: In a second terminal: cd frontend && npm run dev
#
# PROD: Use .env.production (CT_ENV=prod, pgDatabase=GYG-CT-Helper_PROD).
#   You must set APP_ENV=production so the backend loads .env.production.
#   Backend:  From project root run start_prod.bat (it sets APP_ENV=production for you)
#             (or: cd backend && set APP_ENV=production && python -m uvicorn app.main:app --reload --host 0.0.0.0 --port 8001)
#   Frontend: In a second terminal: set VITE_API_BASE_URL=http://localhost:8001 && cd frontend && npm run dev
# =============================================================================
